{
  "name": "@domislink/sso-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply domislink-sso-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply domislink-sso-db --remote"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
