# ===========================================
# DomisLink Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!

# -------------------------------------------
# Backend Configuration
# -------------------------------------------
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/domislink_db"

# JWT/Authentication
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
VITE_API_URL="http://localhost:3000"
VITE_APP_NAME="DomisLink"
VITE_APP_ENV="development"

# -------------------------------------------
# Vercel Deployment (GitHub Actions)
# -------------------------------------------
# Get these from: https://vercel.com/account/tokens
VERCEL_TOKEN="your-vercel-token"
VERCEL_ORG_ID="your-vercel-org-id"
VERCEL_PROJECT_ID="your-vercel-project-id"

# -------------------------------------------
# Render Deployment (Optional)
# -------------------------------------------
# These are set automatically by Render
# RENDER_EXTERNAL_URL=
# RENDER_SERVICE_NAME=
